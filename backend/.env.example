# Copiá este archivo a .env (nunca subas .env al repo).

# Supabase (PostgreSQL) — obligatorio
# Dashboard → Settings → Database → Connection string → URI (Session pooler recomendado)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# SSL (dejar en true para Supabase; false solo en desarrollo local con Postgres sin SSL)
DB_SSL=true
# Ruta al certificado de Supabase (Settings → Database → SSL Configuration) para verificar el servidor
DB_SSL_CA=
DB_POOL_MAX=10

PORT=4002

# 32+ caracteres aleatorios. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_URL=https://diagramtec.qd.je

# URL pública de la API (para los enlaces de verificación de email)
API_PUBLIC_URL=https://api.diagramtec.qd.je

# Proxies delante de Node: 1 = Hostinger solo; 2 = Cloudflare (proxy naranja) + Hostinger
TRUST_PROXY=1

# Cloudflare Turnstile (anti-bots en login, registro y recuperación)
# Dashboard de Cloudflare → Turnstile → Add widget (dominios: diagramtec.qd.je, localhost)
TURNSTILE_SECRET=
# Hostnames del frontend aceptados (sin localhost en producción)
TURNSTILE_HOSTNAMES=diagramtec.qd.je,www.diagramtec.qd.je
# En desarrollo podés usar la clave de prueba de Cloudflare que siempre pasa:
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Google OAuth — callback en la API Node
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.diagramtec.qd.je/auth/google/callback

# Email para recuperación de contraseña (Gmail: usar contraseña de aplicación)
EMAIL_USER=diagramtec@gmail.com
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
