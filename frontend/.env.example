# Copia a .env y ajusta si mueves el proyecto en www de Laragon
VITE_PHP_PATH=/definito/DiagramTec/php
VITE_PHP_TARGET=http://localhost

# Auth local: PHP vía proxy /api/php-auth (default).
# Para probar auth Node local con backend en :4002:
# VITE_USE_NODE_AUTH=true
# VITE_API_URL=/api

# Producción (Hostinger) — ver .env.production:
# VITE_API_URL=https://api.diagramtec.com
# VITE_PHP_AUTH_URL=https://diagramtec.com/php
# VITE_USE_NODE_AUTH=true

# Prueba en el móvil (misma Wi‑Fi que la PC):
#   pnpm run dev  → usa la URL "Móvil" de la terminal (ej. http://192.168.0.37:5173/)
#   NO uses 192.168.56.x (adaptador virtual; el teléfono no llega).
