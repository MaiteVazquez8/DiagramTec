# Copiá a .env.local para desarrollo (nunca subas archivos .env con secretos).

# En desarrollo Vite redirige /api → http://127.0.0.1:4002 (ver vite.config.js).
# Producción (Hostinger): URL pública de la API Node
# VITE_API_URL=https://api.diagramtec.qd.je

# Cloudflare Turnstile: clave PÚBLICA del widget (vacío = sin verificación en desarrollo).
# Clave de prueba que siempre pasa: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Prueba en el móvil (misma Wi‑Fi que la PC):
#   npm run dev  → usa la URL "Móvil" de la terminal (ej. http://192.168.0.37:5173/)
#   NO uses 192.168.56.x (adaptador virtual; el teléfono no llega).
