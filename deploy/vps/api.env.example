# Plantilla de /etc/diagramtec/api.env (permisos 600, propietario diagramtec).
# Completá los valores vacíos en el servidor. Nunca subas el archivo real al repo.

NODE_ENV=production
PORT=4002

# Supabase (PostgreSQL): Dashboard -> Settings -> Database -> Connection string (pooler)
DATABASE_URL=
DB_SSL=true
# Ruta al certificado CA de Supabase (opcional, para verificar el servidor)
DB_SSL_CA=
DB_POOL_MAX=10

# 32+ caracteres aleatorios. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

FRONTEND_URL=https://diagramtec.qd.je
API_PUBLIC_URL=https://api.diagramtec.qd.je

# Proxies delante de Node: solo Nginx = 1
TRUST_PROXY=1

# Cloudflare Turnstile (funciona aunque el dominio no esté en Cloudflare)
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=diagramtec.qd.je,www.diagramtec.qd.je

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.diagramtec.qd.je/auth/google/callback

# Email (recuperación de contraseña; Gmail: contraseña de aplicación)
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
