# Google OAuth — desarrollo local (PHP embebido en Node, puerto 8000)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/google_auth.php?action=callback
# Laragon/Apache (descomentar si usás Apache en lugar del PHP embebido):
# GOOGLE_CALLBACK_URL=http://localhost/definito/DiagramTec/php/google_auth.php?action=callback

# URL del frontend (CORS) — debe coincidir con FRONTEND_URL del backend
FRONTEND_URL=http://localhost:5173

# Producción (Hostinger):
# FRONTEND_URL=https://diagramtec.com
# GOOGLE_CALLBACK_URL=https://diagramtec.com/php/google_auth.php?action=callback
