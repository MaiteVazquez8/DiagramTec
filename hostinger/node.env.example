# Variables para la app Node.js en Hostinger (hPanel → Node.js Web App → Environment)
# Subdominio: api.diagramtec.qd.je
#
# IMPORTANTE: NO agregues PORT — Hostinger lo asigna automáticamente.
# Si PORT=4002 queda en las variables, la app escucha en un puerto distinto al proxy → 503.

NODE_ENV=production

# Supabase (proyecto diagramtec, sa-east-1) con el usuario de API de permisos mínimos.
# Generá este archivo completo con: node scripts/generate-hostinger-node-env.mjs
# Si el panel tiene PGHOST/PGUSER/PGPASSWORD de la base anterior, borralas.
DATABASE_URL=postgresql://diagramtec_api.qjicitmuieyjcnlvvdiu:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=10

JWT_SECRET=

FRONTEND_URL=https://diagramtec.qd.je

# URL pública de la API (para los enlaces de verificación de email)
API_PUBLIC_URL=https://api.diagramtec.qd.je
# Proxies delante de Node: 1 = solo Hostinger; 2 = Cloudflare (proxy naranja) + Hostinger
TRUST_PROXY=1

# Cloudflare Turnstile (anti-bots en login, registro y recuperación)
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=diagramtec.qd.je,www.diagramtec.qd.je

# Gmail: cuenta con verificación en 2 pasos → Contraseñas de aplicaciones
# https://myaccount.google.com/apppasswords → crear una para "DiagramTec"
# Pegá la contraseña de 16 caracteres SIN espacios en EMAIL_PASS
EMAIL_USER=diagramtec@gmail.com
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.diagramtec.qd.je/auth/google/callback
