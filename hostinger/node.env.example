# Variables para la app Node.js en Hostinger (hPanel → Node.js Web App → Environment)
# Subdominio: api.diagramtec.com
#
# IMPORTANTE: NO agregues PORT — Hostinger lo asigna automáticamente.
# Si PORT=4002 queda en las variables, la app escucha en un puerto distinto al proxy → 503.

NODE_ENV=production

DATABASE_URL=postgresql://postgres.tyoskyyaetsyqocjzxib:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=10

# Alternativa recomendada en Hostinger (evita problemas con % en la URI):
# Borrá DATABASE_URL y usá estas — la contraseña va sin codificar:
# PGHOST=aws-1-us-west-2.pooler.supabase.com
# PGUSER=postgres.tyoskyyaetsyqocjzxib
# PGPASSWORD=
# PGDATABASE=postgres
# PGPORT=5432

# Supabase Dashboard → Settings → API (para @supabase/supabase-js / logs Hostinger)
SUPABASE_URL=https://tyoskyyaetsyqocjzxib.supabase.co
SUPABASE_API_KEY=

JWT_SECRET=

FRONTEND_URL=https://diagramtec.com
# Proxies delante de Node: 1 = solo Hostinger; 2 = Cloudflare (proxy naranja) + Hostinger
TRUST_PROXY=1

# Cloudflare Turnstile (anti-bots en login, registro y recuperación)
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=diagramtec.com,www.diagramtec.com

# Gmail: cuenta con verificación en 2 pasos → Contraseñas de aplicaciones
# https://myaccount.google.com/apppasswords → crear una para "DiagramTec"
# Pegá la contraseña de 16 caracteres SIN espacios en EMAIL_PASS
EMAIL_USER=diagramtec@gmail.com
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.diagramtec.com/auth/google/callback
